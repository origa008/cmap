# cmap — environment variables
# Copy to .env.local for local testing, or set in the Vercel dashboard:
#   Project → Settings → Environment Variables
# NEVER commit a real token. .env.local is git-ignored.

# Notion integration token (from https://www.notion.so/my-integrations).
# The integration must be invited to the "cmap – Roadmap Requests" database
# in Notion (database page → ••• → Add connections) or every call returns 403.
NOTION_TOKEN=

# Preferred parent for new rows (Notion API 2025-09-03+).
# Data source UUID of the "cmap – Roadmap Requests" table.
NOTION_DATA_SOURCE_ID=418f63d9-03e3-8130-b73b-000b5891564a

# Fallback parent (legacy form). Used only if the data-source form is rejected.
# Database page UUID (from the database URL).
NOTION_DATABASE_ID=418f63d9-03e3-81c9-9d49-d9da35627894
